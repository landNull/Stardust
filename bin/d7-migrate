#!/bin/sh
# d7-migrate — portable wrapper around the Stardust d7 module.
# On knarr: exec stardust d7 …
# On a BOA VPS (no Stardust, or running as the Aegir user): source lib/d7.sh

set -eu

PROG=${0##*/}
DRYRUN=${DRYRUN:-0}
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

find_lib() {
  for d in \
    "${STARDUST_LIB:-}" \
    "$HERE/lib" \
    "$HERE/../lib" \
    /usr/local/lib/stardust \
    /srv/stardust/lib
  do
    if [ -n "$d" ] && [ -f "$d/d7.sh" ]; then
      echo "$d"
      return 0
    fi
  done
  return 1
}

while [ "${1:-}" = "-n" ]; do
  DRYRUN=1
  shift
done

if command -v stardust >/dev/null 2>&1 \
  && [ "${D7_STANDALONE:-0}" != 1 ] \
  && [ "$(id -u)" -ne 0 ] \
  && [ -z "${SUDO_USER:-}" ]
then
  if [ "$DRYRUN" -eq 1 ]; then
    exec stardust -n d7 "$@"
  fi
  exec stardust d7 "$@"
fi

LIBDIR=$(find_lib) || {
  echo "$PROG: cannot find lib/d7.sh" >&2
  echo "$PROG: on knarr run: stardust d7 help" >&2
  echo "$PROG: on a BOA box keep this next to ../lib/d7.sh" >&2
  exit 1
}

if [ -f "$LIBDIR/common.sh" ]; then
  # shellcheck disable=SC1091
  . "$LIBDIR/common.sh"
fi
# shellcheck disable=SC1091
. "$LIBDIR/d7.sh"

cmd_d7 "$@"
